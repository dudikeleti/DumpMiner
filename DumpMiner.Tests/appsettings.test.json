{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "DumpMiner": "Debug"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "HH:mm:ss.fff "
    },
    "Debug": {
      "IncludeScopes": true
    }
  },
  "Application": {
    "General": {
      "SymbolCachePath": "C:\\temp\\symbols",
      "DefaultTimeoutMs": 30000,
      "EnableDebugLogging": true,
      "MaxConcurrentOperations": 5
    },
    "Appearance": {
      "Theme": "Dark",
      "AccentColor": "#FF0078D4",
      "FontSize": "Small",
      "EnableAnimations": true
    },
    "Advanced": {
      "EnableProfiling": false,
      "EnableMemoryTracking": true,
      "MaxMemoryUsageMB": 2048,
      "EnableDetailedDiagnostics": true,
      "LogLevel": "Debug"
    },
    "AI": {
      "DefaultProvider": "OpenAI",
      "MaxTokens": 4000,
      "TimeoutSeconds": 60,
      "OrchestrationTimeoutSeconds": 300,
      "MaxAutoFunctionCalls": 3,
      "MaxObjectAnalysisDepth": 2,
      "EnableCaching": true,
      "CacheExpirationMinutes": 30,
      "MaxConversationHistory": 10,
      "StackAnalysis": {
        "MaxDetailedThreads": 5,
        "MaxFramesPerThread": 15,
        "MaxTotalPayloadChars": 20000,
        "FilterSystemCode": true
      },
      "Providers": {
        "OpenAI": {
          "ApiKey": "test-openai-key",
          "Model": "gpt-4",
          "BaseUrl": "https://api.openai.com/v1",
          "Temperature": 0.2,
          "TopP": 0.1,
          "MaxTokens": 4000,
          "TimeoutSeconds": 60,
          "IsEnabled": true
        },
        "Anthropic": {
          "ApiKey": "test-anthropic-key",
          "Model": "claude-3-opus-20240229",
          "BaseUrl": "https://api.anthropic.com",
          "Temperature": 0.2,
          "TopP": 0.99,
          "MaxTokens": 4000,
          "TimeoutSeconds": 60,
          "IsEnabled": true
        },
        "Google": {
          "ApiKey": "test-google-key",
          "Model": "gemini-pro",
          "BaseUrl": "https://generativelanguage.googleapis.com",
          "Temperature": 0.2,
          "TopP": 0.95,
          "TopK": 30,
          "MaxTokens": 4000,
          "TimeoutSeconds": 60,
          "IsEnabled": false
        }
      }
    }
  },
  "TestSettings": {
    "DefaultTimeout": "00:00:30",
    "SlowTestTimeout": "00:05:00",
    "PerformanceTestIterations": 10,
    "EnableIntegrationTests": true,
    "EnableExternalTests": false,
    "EnablePerformanceTests": true,
    "TestDataDirectory": "testdata",
    "TempDirectory": "temp",
    "MockAIResponses": true,
    "GenerateTestReports": true,
    "ParallelTestExecution": true,
    "MaxParallelTests": 4,
    "TestEnvironment": "Development",
    "EnableCodeCoverage": true,
    "MinimumCoveragePercent": 80,
    "TestCategories": {
      "Unit": {
        "Enabled": true,
        "MaxExecutionTime": "00:00:05",
        "ParallelExecution": true
      },
      "Integration": {
        "Enabled": true,
        "MaxExecutionTime": "00:00:30",
        "ParallelExecution": false
      },
      "Performance": {
        "Enabled": true,
        "MaxExecutionTime": "00:01:00",
        "ParallelExecution": false,
        "MinIterations": 5,
        "MaxIterations": 100
      },
      "AI": {
        "Enabled": true,
        "MaxExecutionTime": "00:01:00",
        "ParallelExecution": false,
        "UseMockResponses": true
      },
      "External": {
        "Enabled": false,
        "MaxExecutionTime": "00:02:00",
        "ParallelExecution": false,
        "RequireNetworkAccess": true
      }
    }
  },
  "MockSettings": {
    "AI": {
      "SimulateLatency": true,
      "MinLatencyMs": 100,
      "MaxLatencyMs": 2000,
      "SimulateFailures": true,
      "FailureRate": 0.05,
      "DefaultTokens": {
        "PromptTokens": 100,
        "CompletionTokens": 200,
        "TotalTokens": 300
      },
      "DefaultCost": 0.01,
      "DefaultModel": "gpt-4-mock",
      "DefaultProvider": "OpenAI"
    },
    "Operations": {
      "SimulateProcessing": true,
      "ProcessingDelayMs": 50,
      "SimulateMemoryUsage": true,
      "MaxMemoryObjects": 10000,
      "DefaultObjectSize": 1024
    },
    "Configuration": {
      "EnableValidation": true,
      "SimulateFileIO": false,
      "CacheConfigurationChanges": true
    }
  },
  "ValidationSettings": {
    "StrictValidation": true,
    "ValidateAllProperties": true,
    "ValidateRanges": true,
    "ValidateFormats": true,
    "CustomValidators": {
      "MemoryAddress": {
        "MinValue": "0x1000",
        "MaxValue": "0x7FFFFFFFFFFFFFFF"
      },
      "ApiKey": {
        "MinLength": 10,
        "MaxLength": 200,
        "RequirePrefix": false
      },
      "Model": {
        "AllowedValues": [
          "gpt-4",
          "gpt-3.5-turbo",
          "claude-3-opus-20240229",
          "claude-3-sonnet-20240229",
          "claude-3-haiku-20240229",
          "gemini-pro",
          "gemini-1.5-pro"
        ]
      }
    }
  },
  "PerformanceSettings": {
    "Benchmarks": {
      "AIResponse": {
        "ExpectedMaxMs": 5000,
        "ExpectedAvgMs": 2000,
        "ExpectedMinMs": 100
      },
      "MemoryOperation": {
        "ExpectedMaxMs": 1000,
        "ExpectedAvgMs": 200,
        "ExpectedMinMs": 10
      },
      "Configuration": {
        "ExpectedMaxMs": 100,
        "ExpectedAvgMs": 20,
        "ExpectedMinMs": 1
      }
    },
    "Thresholds": {
      "MemoryUsageMB": 1024,
      "CpuUsagePercent": 80,
      "DiskUsageMB": 100,
      "NetworkLatencyMs": 1000
    }
  },
  "IntegrationSettings": {
    "Database": {
      "ConnectionString": "Data Source=:memory:",
      "Provider": "SQLite",
      "EnableMigrations": false,
      "SeedTestData": true
    },
    "FileSystem": {
      "UseTemporaryDirectories": true,
      "CleanupAfterTest": true,
      "MaxFileSize": 10485760,
      "AllowedExtensions": [
        ".dmp",
        ".json",
        ".xml",
        ".txt",
        ".log"
      ]
    },
    "Network": {
      "EnableNetworkTests": false,
      "TimeoutMs": 30000,
      "MaxRetries": 3,
      "RetryDelayMs": 1000
    }
  }
} 